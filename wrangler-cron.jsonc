{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "iskcon-nairobi-calendar-reminders",
  "main": "workers/calendar-reminders.ts",
  "compatibility_date": "2026-11-04",
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "vars": {
    "SITE_URL": "https://iskconnairobi.com"
  }
}
