{
  "name": "iskcon-nairobi",
  "version": "1.1.4",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test --grep-invert @visual",
    "test:a11y:update": "playwright test a11y --update-snapshots",
    "test:visual": "playwright test --grep @visual",
    "test:visual:update": "playwright test --grep @visual --update-snapshots",
    "test:festival": "vitest run src/lib/kirtanSafariState.test.ts",
    "test:calendar-push": "vitest run src/lib/calendarPushSchedule.test.ts",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "baseline:lighthouse": "node scripts/lighthouse-baseline.mjs",
    "send-push": "node --env-file=.env.local scripts/send-push.mjs",
    "images:optimize": "node scripts/optimize-images.mjs",
    "build:cloudflare": "opennextjs-cloudflare build",
    "preview:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy:cloudflare": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy:cloudflare:cron": "wrangler deploy --config wrangler-cron.jsonc",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^12.40.0",
    "lucide-react": "^1.20.0",
    "next": "16.4.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@opennextjs/cloudflare": "1.20.16",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.4.5",
    "googleapis": "174.0.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vitest": "^4.1.11",
    "wrangler": "4.157.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.5",
    "js-yaml": "5.2.3",
    "minimatch": "11.0.1",
    "brace-expansion": "5.0.12",
    "source-map-js": "1.2.2",
    "baseline-browser-mapping": "2.11.0"
  }
}
