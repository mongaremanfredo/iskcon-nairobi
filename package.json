{
  "name": "iskcon-nairobi",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0 <25",
    "npm": ">=11.0.0 <12"
  },
  "packageManager": "npm@11.13.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0",
    "audit:dependencies": "npm audit --audit-level=moderate",
    "test:festival": "vitest run src/lib/kirtanSafariState.test.ts",
    "verify:pwa": "node scripts/verify-pwa.mjs",
    "verify:security": "node scripts/verify-security-config.mjs",
    "verify:assets": "node scripts/verify-repository-assets.mjs",
    "verify:promotion": "node scripts/verify-promotion.mjs",
    "check:release": "npm run audit:dependencies && npm run lint && npm run test:festival && npm run verify:pwa && npm run verify:security && npm run verify:assets && npm run build",
    "send-push": "node --env-file=.env.local scripts/send-push.mjs"
  },
  "dependencies": {
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.40.0",
    "googleapis": "174.0.0",
    "lucide-react": "1.20.0",
    "next": "16.3.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "3.7.0",
    "web-push": "3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.4",
    "js-yaml": "5.2.3",
    "minimatch": "10.2.6",
    "brace-expansion": "5.0.9",
    "baseline-browser-mapping": "2.11.26",
    "browserslist": "4.29.1",
    "qs": "6.16.0"
  },
  "allowScripts": {
    "unrs-resolver": false
  }
